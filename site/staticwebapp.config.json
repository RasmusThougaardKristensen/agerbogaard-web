{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/fonts/*", "/*.css", "/*.js", "/*.svg"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "routes": [
    { "route": "/fonts/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/images/*", "headers": { "cache-control": "public, max-age=604800" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".woff2": "font/woff2"
  }
}
